# Flux Utility Solutions - Environment Configuration
# Copy this file to .env and update values for your environment

# =============================================================================
# SNOWFLAKE CLI CONFIGURATION
# =============================================================================

# Default connection name for snow CLI commands
SNOWFLAKE_DEFAULT_CONNECTION_NAME=cpe_demo_CLI

# =============================================================================
# DEPLOYMENT VARIABLES
# =============================================================================

# Target database for deployment scripts
# Used by quickstart.sh and SQL scripts
DATABASE=FLUX_QUICKSTART

# Compute warehouse
WAREHOUSE=FLUX_QUICKSTART_WH

# Administrator role (for DDL operations)
ADMIN_ROLE=ACCOUNTADMIN

# End-user role (for data access)
USER_ROLE=PUBLIC

# =============================================================================
# OPS CENTER DEPENDENCIES (Optional)
# =============================================================================

# Set to true to deploy Flux Ops Center SPCS dependencies
# This creates ML_DEMO and CASCADE_ANALYSIS schemas with required tables
WITH_OPS_CENTER=false

# =============================================================================
# SEED DATA CONFIGURATION
# =============================================================================

# Source database for seed data (if copying from existing deployment)
# SOURCE_DATABASE=FLUX_DB

# Number of days of AMI sample data to generate
# AMI_SAMPLE_DAYS=7
