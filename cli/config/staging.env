# =============================================================================
# Flux Utility Solutions - Staging Environment
# =============================================================================
# Source this file or use with deploy.sh --env staging
# =============================================================================

# Database Configuration
DATABASE=FLUX_STAGING
WAREHOUSE=FLUX_STAGING_MEDIUM

# Role Configuration
ADMIN_ROLE=FLUX_ADMIN_ROLE
USER_ROLE=FLUX_USER_ROLE

# Compute Resources
WAREHOUSE_SIZE=MEDIUM
WAREHOUSE_AUTO_SUSPEND=60

# Compute Pools (SPCS)
COMPUTE_POOL_MIN_NODES=1
COMPUTE_POOL_MAX_NODES=3

# PostgreSQL
POSTGRES_INSTANCE_SIZE=SMALL

# Feature Flags
ENABLE_ML=true
ENABLE_POSTGRES=true
ENABLE_SPCS=true
ENABLE_CORTEX_SEARCH=true
ENABLE_CORTEX_AGENT=true

# Data Loading
SEED_DATA_SIZE=small
AMI_SAMPLE_DAYS=90
