# =============================================================================
# Flux Utility Solutions - Production Environment
# =============================================================================
# Source this file or use with deploy.sh --env prod
# =============================================================================

# Database Configuration
DATABASE=FLUX_PROD
WAREHOUSE=FLUX_PROD_LARGE

# Role Configuration
ADMIN_ROLE=FLUX_ADMIN_ROLE
USER_ROLE=FLUX_USER_ROLE

# Compute Resources
WAREHOUSE_SIZE=LARGE
WAREHOUSE_AUTO_SUSPEND=120

# Compute Pools (SPCS)
COMPUTE_POOL_MIN_NODES=2
COMPUTE_POOL_MAX_NODES=5

# PostgreSQL
POSTGRES_INSTANCE_SIZE=MEDIUM

# Feature Flags
ENABLE_ML=true
ENABLE_POSTGRES=true
ENABLE_SPCS=true
ENABLE_CORTEX_SEARCH=true
ENABLE_CORTEX_AGENT=true

# Data Loading
SEED_DATA_SIZE=full
AMI_SAMPLE_DAYS=365
