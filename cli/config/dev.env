# =============================================================================
# Flux Utility Solutions - Development Environment
# =============================================================================
# Source this file or use with deploy.sh --env dev
# =============================================================================

# Database Configuration
DATABASE=FLUX_DEV
WAREHOUSE=FLUX_DEV_MEDIUM

# Role Configuration
ADMIN_ROLE=ACCOUNTADMIN
USER_ROLE=PUBLIC

# Compute Resources
WAREHOUSE_SIZE=MEDIUM
WAREHOUSE_AUTO_SUSPEND=60

# Compute Pools (SPCS)
COMPUTE_POOL_MIN_NODES=1
COMPUTE_POOL_MAX_NODES=2

# PostgreSQL
POSTGRES_INSTANCE_SIZE=XS

# Feature Flags
ENABLE_ML=true
ENABLE_POSTGRES=true
ENABLE_SPCS=false
ENABLE_CORTEX_SEARCH=true
ENABLE_CORTEX_AGENT=true

# Data Loading
SEED_DATA_SIZE=small
AMI_SAMPLE_DAYS=30
